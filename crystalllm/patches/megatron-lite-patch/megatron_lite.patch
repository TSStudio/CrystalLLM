new file mode 100644
index 0000000000000000000000000000000000000000..abd2435b9652b8a3c62200a8fa8fa7273d85d120
--- /dev/null
+++ b/megatron/crystal_utils.py
@@ -0,0 +1,26 @@
+# Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+
+"""Helpers for optional Crystal execution modes."""
+
+import os
+
+_CRYSTAL_MODES = frozenset({"CAPTURE", "EMULATE"})
+
+
+def is_crystal_mode_enabled() -> bool:
+    """Return whether this process is running in a Crystal execution mode."""
+    return os.environ.get("CRYSTAL_MODE") in _CRYSTAL_MODES
+
+
+def crystal_group_desc(group_desc: str | None, backend: str | None = None) -> str | None:
+    """Make a process-group description unique during Crystal replay."""
+    if not is_crystal_mode_enabled():
+        return group_desc
+
+    import torch.distributed as dist
+
+    suffix = f"{dist.get_rank()}-{dist.get_pg_count()}-{backend or 'nccl'}"
+    return f"{group_desc}-{suffix}" if group_desc is not None else suffix
+
+
+__all__ = ["crystal_group_desc", "is_crystal_mode_enabled"]

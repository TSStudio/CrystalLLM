+# Copyright (c) 2026 Aliyun Inc. All Rights Reserved.
+
+r"""Tensor Providers for CrystalLLM Replay Assistant."""
+
+from __future__ import annotations
+
+import logging
+import pathlib
+
+import torch
+from crystalllm.replay.data import (
+    ReplayerCommGroupInfo,
+    ReplayerCommOpInfo,
+    TensorMemoryLevel,
+    TensorProvider,
+)
+
+logger = logging.getLogger(__name__)
+
+# P2P activation tensor template configuration
+_P2P_TEMPLATE_DIR = pathlib.Path(__file__).parent
+_P2P_TEMPLATE_FILE = "p2p_activation_template.pt"
+_P2P_TEMPLATE_CACHE = None
+
+
+def _get_p2p_template() -> torch.Tensor | None:
+    """Load and cache the single P2P activation template.
+
+    Returns:
+        The cached template tensor, or None if not available.
+    """
+    global _P2P_TEMPLATE_CACHE
+    if _P2P_TEMPLATE_CACHE is None:
+        filepath = _P2P_TEMPLATE_DIR / _P2P_TEMPLATE_FILE
+        if pathlib.Path(filepath).exists():
+            _P2P_TEMPLATE_CACHE = torch.load(
+                filepath, map_location="cpu", weights_only=True
+            )
+            logger.info(
+                "Loaded P2P template: %s, shape=%s, std=%.4f",
+                _P2P_TEMPLATE_FILE,
+                _P2P_TEMPLATE_CACHE.shape,
+                _P2P_TEMPLATE_CACHE.float().std(),
+            )
+        else:
+            logger.warning("P2P template not found at %s", filepath)
+            _P2P_TEMPLATE_CACHE = False
+    return _P2P_TEMPLATE_CACHE if _P2P_TEMPLATE_CACHE is not False else None
+
+
+def _load_p2p_activation(required_shape: list[int], dtype: torch.dtype) -> torch.Tensor:
+    """Load P2P activation tensor from the single template file.
+
+    Uses simple shape transformation (tile/slice) to generate tensors
+    of any required shape from a single template.
+
+    P2P activation tensor shape format: [seq_length, micro_batch_size, hidden_size]
+        - dim 0: seq_length - Sequence length (may vary with sequence parallel)
+        - dim 1: micro_batch_size - Micro batch size
+        - dim 2: hidden_size - Hidden size (may vary with tensor parallel)
+
+    Args:
+        required_shape: Required tensor shape, e.g. [2048, 1, 5120] or [1024, 2, 5120]
+        dtype: Required tensor dtype
+
+    Returns:
+        Tensor with the specified shape and dtype
+    """
+    if len(required_shape) != 3:
+        return torch.randn(required_shape, dtype=dtype) * 7.0
+
+    template = _get_p2p_template()
+
+    if template is not None:
+        template_shape = list(template.shape)
+
+        if template_shape == required_shape:
+            return template.clone().to(dtype)
+
+        result = template.clone()
+
+        for dim in range(3):
+            t_size = template_shape[dim]
+            r_size = required_shape[dim]
+
+            if r_size != t_size:
+                if r_size > t_size:
+                    repeat_times = (r_size + t_size - 1) // t_size
+                    repeats = [1, 1, 1]
+                    repeats[dim] = repeat_times
+                    result = result.repeat(*repeats)
+                slices = [slice(None), slice(None), slice(None)]
+                slices[dim] = slice(r_size)
+                result = result[tuple(slices)]
+
+        assert list(result.shape) == required_shape, (
+            f"Shape mismatch after resize: {result.shape} != {required_shape}"
+        )
+        return result.to(dtype)
+
+    logger.warning("P2P activation template not available")
+    return torch.randn(required_shape, dtype=dtype) * 7.0
+
+
+def _is_p2p_forward_activation(
+    rank: int,
+    replay_op: ReplayerCommOpInfo,
+    comm_group: ReplayerCommGroupInfo,
+) -> bool:
+    """Determine if a P2P isend operation is sending forward activations.
+
+    For pipeline parallelism P2P communication:
+    - Forward pass: isend to next PP stage
+    - Backward pass: isend to previous PP stage
+
+    Args:
+        rank: The rank that owns this tensor demand.
+        replay_op: The communication operation info for the demand.
+        comm_group: The communication group the operation belongs to.
+
+    Returns:
+        True if this is a forward activation send, False if backward gradient.
+    """
+    group_ranks = comm_group.ranks
+    group_size = len(group_ranks)
+
+    my_group_rank = group_ranks.index(rank)
+
+    if "group_dst" in replay_op.meta:
+        group_dst = replay_op.meta["group_dst"]
+    elif "dst" in replay_op.meta:
+        dst_global_rank = replay_op.meta["dst"]
+        group_dst = group_ranks.index(dst_global_rank)
+    else:
+        raise ValueError(f"No destination info in op {replay_op}")
+
+    next_stage = (my_group_rank + 1) % group_size
+    return group_dst == next_stage
+
+
+class LogicalAndProvider(TensorProvider):
+    """Provider for logical_and_across_model_parallel_group operations.
+
+    Creates a tensor filled with ones for logical AND operations.
+    """
+
+    def can_handle(
+        self,
+        _rank: int,
+        replay_op: ReplayerCommOpInfo,
+        _comm_group: ReplayerCommGroupInfo,
+    ) -> bool:
+        return "logical_and_across_model_parallel_group" in replay_op.signature
+
+    def tensor_memory_level(
+        self,
+        _rank: int,
+        _replay_op: ReplayerCommOpInfo,
+        _comm_group: ReplayerCommGroupInfo,
+    ) -> TensorMemoryLevel:
+        return TensorMemoryLevel.PERSISTENT
+
+    def provide(
+        self,
+        _rank: int,
+        replay_op: ReplayerCommOpInfo,
+        _comm_group: ReplayerCommGroupInfo,
+        _use_index: int = -1,
+    ) -> torch.Tensor:
+        return torch.ones(replay_op.input_shape, dtype=replay_op.input_dtype)
+
+
+class P2PActivationOrGradientProvider(TensorProvider):
+    """Provider for P2P isend forward activations and backward gradients.
+
+    Forward activations use the captured template. Backward gradients use the
+    historical random distribution with std ~ 3.6e-8.
+    """
+
+    def can_handle(
+        self,
+        _rank: int,
+        replay_op: ReplayerCommOpInfo,
+        _comm_group: ReplayerCommGroupInfo,
+    ) -> bool:
+        return replay_op.c10d_func_name == "isend"
+
+    def tensor_memory_level(
+        self,
+        _rank: int,
+        _replay_op: ReplayerCommOpInfo,
+        _comm_group: ReplayerCommGroupInfo,
+    ) -> TensorMemoryLevel:
+        return TensorMemoryLevel.PERSISTENT
+
+    def provide(
+        self,
+        rank: int,
+        replay_op: ReplayerCommOpInfo,
+        comm_group: ReplayerCommGroupInfo,
+        _use_index: int = -1,
+    ) -> torch.Tensor:
+        if _is_p2p_forward_activation(rank, replay_op, comm_group):
+            return _load_p2p_activation(replay_op.input_shape, replay_op.input_dtype)
+        return torch.randn(replay_op.input_shape, dtype=replay_op.input_dtype) * 3.6e-8
+
+
+class GradSyncProvider(TensorProvider):
+    """Provider for gradient sync operations (start_grad_sync).
+
+    Gradient buffer for AllReduce/ReduceScatter before optimizer step.
+    Real gradients have std ~ 7.9e-6, range [-6.3e-4, 6.4e-4].
+    """
+
+    def can_handle(
+        self,
+        _rank: int,
+        replay_op: ReplayerCommOpInfo,
+        _comm_group: ReplayerCommGroupInfo,
+    ) -> bool:
+        return "start_grad_sync" in replay_op.signature
+
+    def tensor_memory_level(
+        self,
+        _rank: int,
+        _replay_op: ReplayerCommOpInfo,
+        _comm_group: ReplayerCommGroupInfo,
+    ) -> TensorMemoryLevel:
+        return TensorMemoryLevel.SHARED
+
+    def provide(
+        self,
+        _rank: int,
+        replay_op: ReplayerCommOpInfo,
+        _comm_group: ReplayerCommGroupInfo,
+        _use_index: int = -1,
+    ) -> torch.Tensor:
+        return torch.randn(replay_op.input_shape, dtype=replay_op.input_dtype) * 7.9e-6
+
+
+class ParamSyncProvider(TensorProvider):
+    """Provider for parameter sync operations (start_param_sync).
+
+    Parameter buffer for AllGather after optimizer step.
+    Real params have std ~ 0.012, mean ~ 0, range [-0.05, 1.0].
+    """
+
+    def can_handle(
+        self,
+        _rank: int,
+        replay_op: ReplayerCommOpInfo,
+        _comm_group: ReplayerCommGroupInfo,
+    ) -> bool:
+        return "start_param_sync" in replay_op.signature
+
+    def tensor_memory_level(
+        self,
+        _rank: int,
+        _replay_op: ReplayerCommOpInfo,
+        _comm_group: ReplayerCommGroupInfo,
+    ) -> TensorMemoryLevel:
+        return TensorMemoryLevel.SHARED
+
+    def provide(
+        self,
+        _rank: int,
+        replay_op: ReplayerCommOpInfo,
+        _comm_group: ReplayerCommGroupInfo,
+        _use_index: int = -1,
+    ) -> torch.Tensor:
+        return torch.randn(replay_op.input_shape, dtype=replay_op.input_dtype) * 0.012
+
+
+class GradStatsProvider(TensorProvider):
+    """Provider for scalar gradient statistics (get_grad_norm_fp32).
+
+    total_norm shoule not be a negative number and make total_norm ** 0.5 a complex.
+    Values are tiny positives ~ 1e-8.
+    """
+
+    def can_handle(
+        self,
+        _rank: int,
+        replay_op: ReplayerCommOpInfo,
+        _comm_group: ReplayerCommGroupInfo,
+    ) -> bool:
+        return "get_grad_norm_fp32" in replay_op.signature
+
+    def tensor_memory_level(
+        self,
+        _rank: int,
+        _replay_op: ReplayerCommOpInfo,
+        _comm_group: ReplayerCommGroupInfo,
+    ) -> TensorMemoryLevel:
+        return TensorMemoryLevel.SHARED
+
+    def provide(
+        self,
+        _rank: int,
+        replay_op: ReplayerCommOpInfo,
+        _comm_group: ReplayerCommGroupInfo,
+        _use_index: int = -1,
+    ) -> torch.Tensor:
+        return (
+            torch.randn(replay_op.input_shape, dtype=replay_op.input_dtype).abs_()
+            * 1e-8
+        )
+
+
+TENSOR_PROVIDERS: list[TensorProvider] = [
+    LogicalAndProvider(),
+    GradStatsProvider(),
+    P2PActivationOrGradientProvider(),
+    GradSyncProvider(),
+    ParamSyncProvider(),
+]

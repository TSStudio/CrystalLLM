+
+# env_options
+# These options MUST be passed by environment variables
+env_options=" \
+    --train-iters ${CRYSTAL_TRAIN_ITERS} \
+    --profile-step-start ${CRYSTAL_ANALYSIS_STEP_START} \
+    --profile-step-end ${CRYSTAL_ANALYSIS_STEP_END}"
+
+# profiler_options
+if [ "$USE_NSIGHT_SYSTEM" = true ]; then
+    # Nsight System
+    mkdir -p $CRYSTAL_LOG_DIR/profiler/nsys
+
+    STARTUP_COMMAND="${NSYS_PROFILE} ${STARTUP_COMMAND}"
+    profiler_options=" \
+        --profile"
+elif [ "$USE_PYTORCH_PROFILER" = true ]; then
+    # PyTorch Profiler
+    mkdir -p $CRYSTAL_LOG_DIR/profiler/pytorch
+
+    profiler_options=" \
+        --profile \
+        --use-pytorch-profiler"
+else
+    profiler_options=" \
+        "
+fi
+
+# tensorboard_options
+if [ "$ENABLE_TENSORBOARD" = true ]; then
+    TENSORBOARD_DIR=${CRYSTAL_LOG_DIR}/tensorboard
+    mkdir -p $TENSORBOARD_DIR
+    tensorboard_options=" \
+        --tensorboard-dir ${TENSORBOARD_DIR} \
+        --tensorboard-queue-size 1 \
+        --log-timers-to-tensorboard"
+else
+    tensorboard_options=" \
+    "
+fi
+
+# attn_backend_option
+if [ $FL = true ]; then
+    export NVTE_FLASH_ATTN=1 NVTE_FUSED_ATTN=0
+    attn_backend_option=" \
+        --attention-backend flash"
+elif [ $FL = false ]; then
+    export NVTE_FLASH_ATTN=0 NVTE_FUSED_ATTN=1
+    attn_backend_option=" \
+        --attention-backend fused"
+fi
+
+# gpt_options
+if [ $MODEL_SIZE = 20B ]; then
+    gpt_options=" \
+        --num-layers 64 \
+        --hidden-size 5120 \
+        --num-attention-heads 40 \
+        --seq-length 2048 \
+        --max-position-embeddings 2048"
+elif [ $MODEL_SIZE = 175B ]; then
+    gpt_options=" \
+        --num-layers 96 \
+        --hidden-size 12288 \
+        --num-attention-heads 96 \
+        --seq-length 2048 \
+        --max-position-embeddings 2048"
+fi
+

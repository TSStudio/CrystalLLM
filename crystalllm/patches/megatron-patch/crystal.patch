+#!/bin/bash
+
+SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")/" && pwd)
+RESOURCE_DIR=${SCRIPT_DIR}/downloads/qwen3
+
+mkdir -p $RESOURCE_DIR
+
+# Dataset files must be supplied by the user.
+mkdir -p $RESOURCE_DIR/dataset
+
+# tokenizer
+mkdir -p $RESOURCE_DIR/tokenizer
+wget https://www.modelscope.cn/models/Qwen/Qwen3-32B/resolve/master/vocab.json -O $RESOURCE_DIR/tokenizer/vocab.json
+wget https://www.modelscope.cn/models/Qwen/Qwen3-32B/resolve/master/merges.txt -O $RESOURCE_DIR/tokenizer/merges.txt
+wget https://www.modelscope.cn/models/Qwen/Qwen3-32B/resolve/master/tokenizer.json -O $RESOURCE_DIR/tokenizer/tokenizer.json
+wget https://www.modelscope.cn/models/Qwen/Qwen3-32B/resolve/master/tokenizer_config.json -O $RESOURCE_DIR/tokenizer/tokenizer_config.json

+    do_option=" \
+        --use-distributed-optimizer"
+elif [ $DO = false ]; then
+    do_option=" \
+    "
+fi
+
+# load_options
+load_options=" \
+    --vocab-file $RESOURCE_PATH/tokenizer/gpt2-vocab.json \
+    --merge-file $RESOURCE_PATH/tokenizer/gpt2-merges.txt"
+
+# dataset_options
+dataset_options=" \
+    --mock-data \
+    --split 1,1,0"
+
+# megatron_options
+megatron_options=" \
+    --manual-gc \
+    --manual-gc-interval 100 \
+    --bf16 \
+    --lr ${LR} \
+    --min-lr ${MIN_LR} \
+    --lr-decay-style cosine \
+    --weight-decay 0.1 \
+    --adam-beta1 0.9 \
+    --adam-beta2 0.95 \
+    --init-method-std 0.006 \
+    --clip-grad 1.0 \
+    --lr-warmup-fraction .001 \
+    --lr-decay-iters 430000 \
+    --log-interval 1 \
+    --log-throughput \
+    --eval-iters 0 \
+    --ckpt-format torch_dist \
+    --disable-gloo-process-groups \
+    --transformer-impl transformer_engine \
+    --seed 1234"
+
+run_cmd="${STARTUP_COMMAND} pretrain_gpt_crystal.py \
+${megatron_options} \
+${dataset_options} \
+${load_options} \
+${do_option} \
+${activation_checkpoint_options} \
+${gpt_options} \
+${attn_backend_option} \
+${tensorboard_options} \
+${profiler_options} \
+${env_options} \
+${debug_options} \
+${CONFIG_ARGS}
+"
+
+cd $CURRENT_DIR
+echo ${run_cmd}
+eval ${run_cmd}

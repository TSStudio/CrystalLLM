+# | NetPlugin | 128 | KernelCh  | 64  |
+# | ProxyCtrl | 32  | ProxyStep | 16  |
+# | ProxyOp   | 8   | P2p       | 4   |
+# | Coll      | 2   | Group     | 1   |
+# |-----------|-----|-----------|-----|
+if [ "$ENABLE_NCCL_PROFILER" = true ]; then
+    # NCCL Profiler
+    mkdir -p $CRYSTAL_LOG_DIR/profiler/nccl
+    # 通过 crystalllm_nccl_profiler python extension 查询 plugin 所在目录并装载
+    # See ext-profiler/example/python_ext/README.md
+    export LD_LIBRARY_PATH="$(python -m crystalllm_nccl_profiler lib-dir):${LD_LIBRARY_PATH}"
+fi
+
+export NCCL_PROFILE_EVENT_MASK=$((64+4+2+1))
+export NCCL_PROFILE_GROUP_POOL_SIZE=${CUSTOM_NCCL_PROFILER_POOL_SIZE:-2048}
+export NCCL_PROFILE_COLL_POOL_SIZE=${CUSTOM_NCCL_PROFILER_POOL_SIZE:-2048}
